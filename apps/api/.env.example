NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/nouveau
SESSION_SECRET=replace-with-a-random-32+-character-string
CORS_ORIGIN=http://localhost:5173
KMS_LOCAL_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32

# Email: defaults to logging to stdout. Set EMAIL_PROVIDER=resend plus both
# of RESEND_API_KEY and EMAIL_FROM to send real email via Resend.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=Nouveau <onboarding@your-verified-domain.example>

# Cookie SameSite: "lax" works when apps/marketing and apps/api share a
# registrable domain. Set to "none" only if they're on genuinely different
# domains (e.g. two separate *.vercel.app projects).
COOKIE_SAME_SITE=lax

# Real MetaApi token — optional (the server boots fine without it; auth,
# the bot list, and the dashboard all work), but bot linking responds with
# a clear 503 until this is set, since there's no simulator for it. Covers
# both account provisioning and CopyFactory strategy/subscriber management.
# Create an account at metaapi.cloud and generate a token from the API
# access page, then paste it here directly — never into chat.
# META_API_TOKEN=your_metaapi_token_here

# Real Paystack secret key — optional the same way; checkout responds with
# a clear 503 until this is set. Use a TEST mode key (sk_test_...) for
# local/manual testing.
# PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
