NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/nouveau
SESSION_SECRET=replace-with-a-random-32+-character-string
CORS_ORIGIN=http://localhost:5173
KMS_LOCAL_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
TRADING_MODE=paper

# Email: defaults to logging to stdout. Set EMAIL_PROVIDER=resend plus both
# of RESEND_API_KEY and EMAIL_FROM to send real email via Resend.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=Nouveau <onboarding@your-verified-domain.example>

# Cookie SameSite: "lax" works when apps/marketing and apps/api share a
# registrable domain (e.g. app.example.com + api.example.com). Set to
# "none" only if they're on genuinely different domains (e.g. a Vercel
# *.vercel.app frontend calling a Render *.onrender.com API) — otherwise
# login silently fails in production while working fine in dev.
COOKIE_SAME_SITE=lax

# Trader-track live market data + broker-account linking: both default to a
# synthetic simulator. Set MARKET_DATA_PROVIDER=metaapi and/or
# BROKER_LINK_PROVIDER=metaapi plus META_API_TOKEN to switch either one to
# real MetaApi (metaapi.cloud) data — get the token from your MetaApi
# dashboard and put it here directly, never in chat or a commit.
MARKET_DATA_PROVIDER=simulator
BROKER_LINK_PROVIDER=simulator
# META_API_TOKEN=your_metaapi_token_here
# The MetaApi account id (not a broker login) of one dedicated demo account
# kept connected purely as the market-data feed for every trader's signal
# requests. Required only when MARKET_DATA_PROVIDER=metaapi.
# META_API_ACCOUNT_ID=your_metaapi_account_id_here

PAYMENT_PROVIDER=simulator
LLM_NARRATION_PROVIDER=template
# ANTHROPIC_API_KEY=your_anthropic_key_here
