{
  "name": "@nouveau/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vercel-build": "esbuild src/vercelHandler.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:express --external:express-session --external:connect-mongo --external:express-rate-limit --external:cors --external:zod --external:dotenv --external:mongoose --external:argon2"
  },
  "dependencies": {
    "@nouveau/core": "0.1.0",
    "@nouveau/db": "0.1.0",
    "@nouveau/security": "0.1.0",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "connect-mongo": "5.1.0",
    "express-rate-limit": "7.4.1",
    "cors": "2.8.5",
    "zod": "3.23.8",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "esbuild": "0.21.5",
    "vitest": "2.1.4",
    "supertest": "7.0.0",
    "mongodb-memory-server": "10.1.2",
    "@types/node": "20.16.11",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/cors": "2.8.17",
    "@types/supertest": "6.0.2"
  }
}
