# Vite loads this automatically for production builds (`vite build`), so
# a deployed marketing site talks to the real backend by default — no
# reliance on a Vercel dashboard env var being set correctly, which has
# been a repeated source of silent misconfiguration on this project.
# Not a secret: this URL is baked into client-side JS and visible to any
# visitor in their browser's network tab regardless of where it's defined.
VITE_API_BASE_URL=https://nouveau-api.vercel.app
